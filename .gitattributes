* text=auto
*.py text eol=lf
*.md text eol=lf

# CAD и бинарники: не сравнивать построчно
*.step binary
*.stp binary
*.stl binary
*.dxf -diff
*.pdf binary
*.png binary
*.jpg binary
*.SLDPRT binary
*.SLDASM binary
*.SLDDRW binary

# SolidWorks читает эти файлы в Windows-формате (CRLF, .bas в cp1251)
*.bas text eol=crlf
*.swb text eol=crlf
roboruka_v1/solidworks/data/*.txt text eol=crlf
roboruka_v1/solidworks/params.txt text eol=crlf
*.swp binary
